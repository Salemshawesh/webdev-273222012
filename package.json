{
  "name": "webdev-273222012",
  "version": "1.0.0",
  "description": "This repository is your workspace for the whole course: Exercise 1 in `mcp-server/`, and your project (Exercises 2–5) in the rest of it. Everything runs in your browser through GitHub Codespaces, so nothing needs to be installed on your laptop.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test",
    "seed": "node src/seed.js",
    "coverage:services": "node --test --experimental-test-coverage --test-coverage-include='src/services/**' --test-coverage-exclude='test/**' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100",
    "coverage": "npm run coverage:services && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='test/**' --test-coverage-lines=80",
    "mcp": "node mcp-server/server.js",
    "start": "node src/server.js"
  },
