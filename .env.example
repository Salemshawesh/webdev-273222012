# Values below are placeholders. Configure secrets in Codespaces or Render, not in Git.
PORT=3000
# Leave DATABASE_URL unset for local SQLite. Use the Neon URL with sslmode=require in production.
DATABASE_URL=
DATABASE_PATH=campus.sqlite
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
# Default is in src/providers/model.js; override only to choose another supported model.
MODEL_NAME=
# Ordinary opaque session token, issued by the same auth service as website sign-in.
MCP_TOKEN=
